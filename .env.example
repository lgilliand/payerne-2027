# Copier ce fichier en `.env` et remplir les valeurs.

# Clé secrète utilisée par Payload pour signer les sessions : longue chaîne aléatoire,
# par exemple générée avec `openssl rand -hex 32`. Ne jamais la partager ni la changer en production.
PAYLOAD_SECRET=

# Base de données SQLite. En local, laisser la valeur par défaut.
# En production, utiliser un chemin absolu HORS du dossier du site, pour qu'elle survive aux déploiements :
# DATABASE_URL=file:/chemin/absolu/vers/data/payload.db
DATABASE_URL=file:./data/payload.db

# Dossier des images envoyées depuis l'administration (même remarque qu'au-dessus)
MEDIA_DIR=./data/media


# Envoi des e-mails du formulaire de contact (messagerie Infomaniak).
# Sans SMTP_HOST, les e-mails sont seulement affichés dans la console (suffisant en local).
# Utiliser une adresse de la messagerie, par exemple noreply@payerne2027.ch, et son mot de passe.
# SMTP_HOST=mail.infomaniak.com
# SMTP_PORT=465
# SMTP_USER=noreply@payerne2027.ch
# SMTP_PASSWORD=
# Adresse d'expédition, par défaut SMTP_USER
# SMTP_FROM=
